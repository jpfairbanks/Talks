{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/frame/**",
              "components/math/**",
              "slides/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:XITS|XITS Math|JuliaMono))/i]",
        "message": "Font not provided by the design system. Available: XITS, XITS Math, JuliaMono."
      },
      {
        "selector": "JSXOpeningElement[name.name='BulletItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|level|key|ref|className|style|children)$/]",
        "message": "<BulletItem> doesn't accept that prop. Declared props: text, level."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|tone|style|key|ref|className|style|children)$/]",
        "message": "<Caption> doesn't accept that prop. Declared props: children, align, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Caption> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Caption'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:quiet|strong)$/]",
        "message": "<Caption> tone must be one of 'quiet' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Credit'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|align|style|key|ref|className|style|children)$/]",
        "message": "<Credit> doesn't accept that prop. Declared props: children, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Credit'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Credit> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigurePlate'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|captionPlacement|panel|fit|style|imgStyle|key|ref|className|style|children)$/]",
        "message": "<FigurePlate> doesn't accept that prop. Declared props: src, alt, caption, captionPlacement, panel, fit, style, imgStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigurePlate'] > JSXAttribute[name.name='captionPlacement'] > Literal[value!=/^(?:top|bottom)$/]",
        "message": "<FigurePlate> captionPlacement must be one of 'top' | 'bottom'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FigurePlate'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:contain|cover)$/]",
        "message": "<FigurePlate> fit must be one of 'contain' | 'cover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowArrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tint|direction|style|key|ref|className|style|children)$/]",
        "message": "<FlowArrow> doesn't accept that prop. Declared props: label, tint, direction, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowArrow'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:right|left)$/]",
        "message": "<FlowArrow> direction must be one of 'right' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightRegion'] > JSXAttribute > JSXIdentifier[name!=/^(?:tint|label|labelSize|children|style|key|ref|className|style|children)$/]",
        "message": "<HighlightRegion> doesn't accept that prop. Declared props: tint, label, labelSize, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MathBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:tex|display|style|key|ref|className|style|children)$/]",
        "message": "<MathBlock> doesn't accept that prop. Declared props: tex, display, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OutlinedRegion'] > JSXAttribute > JSXIdentifier[name!=/^(?:stroke|label|labelSize|children|style|key|ref|className|style|children)$/]",
        "message": "<OutlinedRegion> doesn't accept that prop. Declared props: stroke, label, labelSize, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoWallPhoto'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|span|rowSpan|key|ref|className|style|children)$/]",
        "message": "<PhotoWallPhoto> doesn't accept that prop. Declared props: src, alt, span, rowSpan."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlideFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|title|titleSize|number|banner|style|key|ref|className|style|children)$/]",
        "message": "<SlideFrame> doesn't accept that prop. Declared props: children, title, titleSize, number, banner, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|label|tint|children|style|key|ref|className|style|children)$/]",
        "message": "<StepBox> doesn't accept that prop. Declared props: index, label, tint, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TheoremBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|number|name|children|italic|style|key|ref|className|style|children)$/]",
        "message": "<TheoremBlock> doesn't accept that prop. Declared props: kind, number, name, children, italic, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|height|style|key|ref|className|style|children)$/]",
        "message": "<TitleBanner> doesn't accept that prop. Declared props: src, height, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
